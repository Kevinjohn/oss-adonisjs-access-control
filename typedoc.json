{
  "$schema": "https://typedoc.org/schema.json",
  "entryPoints": [
    "index.ts",
    "src/types.ts",
    "src/memberships.ts",
    "providers/access_control_provider.ts",
    "services/main.ts",
    "src/middleware/main.ts",
    "src/account_kit/main.ts"
  ],
  "out": "docs/reference/api",
  "plugin": ["typedoc-plugin-markdown"],
  "entryFileName": "index",
  "readme": "none",
  "excludePrivate": true,
  "excludeInternal": true,
  "hidePageHeader": true,
  "githubPages": false,
  "gitRevision": "main",
  "treatWarningsAsErrors": true,
  "validation": { "notDocumented": true },
  "requiredToBeDocumented": ["Class", "Function", "Interface", "TypeAlias", "Variable"],
  "intentionallyNotExported": [
    "AlreadyMemberException",
    "ConflictException",
    "ForbiddenException",
    "InvalidConfigException",
    "InvalidInputException",
    "LastOwnerException",
    "NotAMemberException",
    "OwnerDisabledException",
    "OwnerProtectedException",
    "RankTooLowException",
    "ScopeNotEmptyException",
    "ScopeNotFoundException",
    "SelfManagementException",
    "UnknownRoleException",
    "UserNotFoundException"
  ],
  "externalSymbolLinkMappings": {
    "@adonisjs/ace": {
      "CommandMetaData": "https://github.com/adonisjs/ace"
    }
  }
}
